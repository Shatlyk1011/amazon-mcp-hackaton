# Server-only Mapbox token used by the calculate_route MCP tool.
# Create one at https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

# Public browser token used only by Mapbox GL JS for map rendering.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here
# Server-only RentCast API key for live rental listings.
# Create one at https://developers.rentcast.io/
RENTCAST_API_KEY=your_rentcast_api_key_here
# Server-only TomTom key with Search API enabled.
# Create one at https://developer.tomtom.com/
TOMTOM_API_KEY=your_tomtom_api_key_here

# Server-only Neon PostgreSQL connection string. Run pnpm db:migrate after setting it.
DATABASE_URL=postgresql://user:password@your-neon-host/database?sslmode=require
# Server-only OpenAI API key. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini
# Optional override for recorded voice transcription.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Canonical application origin used by the server-side MCP client.
# Change the port if your local dev server uses a different port; use HTTPS in production.
APP_URL=http://localhost:3000
